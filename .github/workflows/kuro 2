# Builds Kuro 2.0 (Minecraft 1.21.11) entirely on GitHub - nothing else needed in this repo.
# After it runs: open the "build-kuro" run in the Actions tab and download "kuro-mod" at the bottom.
name: build-kuro
on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-24.04
